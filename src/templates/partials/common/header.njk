{% from 'src/templates/partials/ui/elements.njk' import icon %}

<header class="header">
  <div class="header__wrapper wrapper">
    <div class="header__menu-block">
      <label id="burger" class="header__burger burger button button--primary button--icon">
        <input type="checkbox" class="header__burger-icon burger__icon">
        <ul class="header__menu">
          {% for item in header__menu %}
            <li class="header__menu-item">
              <a href="{{ item.href }}" class="header__menu-link">
                {{ item.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </label>
      <a href="/" class="header__logo">
        <img src="/src/assets/images/logo.svg" alt="logo">
      </a>
    </div>
    <div class="header__actions-block">
      <button
        class="header__action-search button button--secondary button--icon"
        type="button"
      >
        {{ icon("search-md", "header__action-search-icon") }}
      </button>
      <input type="search" class="header__search-input input" placeholder="Search for Digital Assets">
      <button
        class="header__action-shopping-bag button button--primary button--icon"
        type="button"
      >
        {{ icon("shopping-bag", "header__action-shopping-bag-icon") }}
      </button>
    </div>
  </div>
</header>

