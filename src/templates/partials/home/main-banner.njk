{% import 'src/templates/partials/ui/elements.njk' as ui %}

<section class="main-banner">
    <div class="main-banner__wrapper wrapper">
        <div class="main-banner__illustration">
            <img class="main-banner__img main-banner__img--third"
                 src="/src/assets/images/main-banner-3.png?format=webp"
                 alt="">
            <img class="main-banner__img main-banner__img--second"
                 src="/src/assets/images/main-banner-2.png?format=webp"
                 alt="">
            <img class="main-banner__img main-banner__img--first"
                 src="/src/assets/images/main-banner-1.png?format=webp"
                 alt="">
            <div class="main-banner__img main-banner__img--fourth">
                {{ ui.icon('pen', 'main-banner__icon') }}
            </div>
            <div class="main-banner__img main-banner__img--fifth">
                {{ ui.icon('color-pallet', 'main-banner__icon') }}
            </div>

        </div>

        <div class="main-banner__content">
            <h1 class="main-banner__title">Craft Your Success with Our <span
                        class="main-banner__title-accent">Digital</span> Assets</h1>

            <p class="main-banner__subtitle">From our inspiring illustrations to dynamic UI/UX kits, elevate your
                projects
                with
                our premium digital design resources.</p>

            <div class="main-banner__cta">
                <button class="main-banner__action-button button button--primary button--lg">
                    Shop now
                </button>

                <button class="main-banner__action-button button button--flat button--lg">
                    {{ ui.icon('play-fill', 'main-banner__icon') }}
                    Watch about us
                </button>
            </div>
        </div>
    </div>
</section>